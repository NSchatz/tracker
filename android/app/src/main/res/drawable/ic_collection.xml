<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground service's status-bar icon. A location pin, drawn as a vector so it renders at every
  density without shipping five bitmaps.

  Status-bar icons are drawn as a SILHOUETTE: the system takes the alpha channel and discards the
  colour, so this is a solid white path with the shape carried entirely by transparency. A
  multi-coloured icon here would render as an unrecognisable blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13c0,-3.87 -3.13,-7 -7,-7zM12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5 2.5,1.12 2.5,2.5 -1.12,2.5 -2.5,2.5z" />
</vector>
