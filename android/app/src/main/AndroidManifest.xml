<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The client reports fixes to the family's server, so it needs the network from day one.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      C1 — location collection.

      ACCESS_COARSE_LOCATION is declared alongside FINE deliberately, not as a fallback afterthought:
      from Android 12 the user can answer the location prompt with "Approximate", and an app that
      declares only FINE still ends up with a coarse grant. Declaring both is what lets that state be
      detected and labelled honestly rather than mistaken for precise.

      ACCESS_BACKGROUND_LOCATION is what makes collection survive the app being closed. It became a
      separate runtime permission in Android 10 (API 29) — this app's minSdk — and it is requested as
      a SECOND, separate step, never bundled with the foreground request. On Android 11+ the runtime
      prompt has no "Allow all the time" option at all and only the settings page can grant it; see
      permission/LocationPermissionFlow.kt.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      The foreground service. FOREGROUND_SERVICE_LOCATION is required for a service of
      type=location, and from Android 14 (API 34 — this app's target) declaring the type is
      mandatory, not optional.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      Android 13+: without this, the service's ongoing notification is suppressed. The service still
      runs, but the person carrying the phone loses the always-visible signal that it is collecting —
      which is the whole bargain a location foreground service is built on. Requested at runtime with
      the foreground-location step, and its absence is surfaced in the UI rather than ignored.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      REBOOT-1 - collection survives a reboot.

      Without this the app is not told the device booted, and a phone whose operator asked it to
      report simply stops reporting until somebody notices and opens the app. It is a normal
      (install-time) permission, not a runtime one: there is no prompt, and the user's control over
      it is the app's own collection setting plus the location grant the restart still needs.

      It does NOT cover a force-stopped app. ACTION_BOOT_COMPLETED is not delivered to an app in the
      stopped state until a user action removes it from that state, so this permission buys the
      ordinary reboot and nothing else; see android/README.md, "Known limitations".
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tracker">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported="false": nothing outside this app may start location collection. An exported
          service that collects location would let any app on the device turn the family tracker on.
        -->
        <service
            android:name=".collect.LocationCollectionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          exported="true" because ACTION_BOOT_COMPLETED is delivered by the system, which is outside
          this app, and a manifest-declared receiver that is not exported never hears it. That is
          safe here and only here: BOOT_COMPLETED is a PROTECTED broadcast, which only the system
          may send, so no other app can forge one. The receiver additionally refuses any intent
          whose action is not exactly ACTION_BOOT_COMPLETED, so even a delivery route nobody has
          thought of cannot use it to turn location collection on.

          Not directBootAware: this app's state lives in credential-protected storage, so it has
          nothing it could read before the first unlock. The consequence is stated rather than
          hidden - the broadcast arrives when the platform delivers it for a non-direct-boot app,
          and every operator check for the reboot is written to unlock the device once so that no
          verdict depends on where that point falls.
        -->
        <receiver
            android:name=".collect.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
