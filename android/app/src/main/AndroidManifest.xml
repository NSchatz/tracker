<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The client reports fixes to the family's server, so it needs the network from day one.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      C1 — location collection.

      ACCESS_COARSE_LOCATION is declared alongside FINE deliberately, not as a fallback afterthought:
      from Android 12 the user can answer the location prompt with "Approximate", and an app that
      declares only FINE still ends up with a coarse grant. Declaring both is what lets that state be
      detected and labelled honestly rather than mistaken for precise.

      ACCESS_BACKGROUND_LOCATION is what makes collection survive the app being closed. It became a
      separate runtime permission in Android 10 (API 29) — this app's minSdk — and it is requested as
      a SECOND, separate step, never bundled with the foreground request. On Android 11+ the runtime
      prompt has no "Allow all the time" option at all and only the settings page can grant it; see
      permission/LocationPermissionFlow.kt.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      The foreground service. FOREGROUND_SERVICE_LOCATION is required for a service of
      type=location, and from Android 14 (API 34 — this app's target) declaring the type is
      mandatory, not optional.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      Android 13+: without this, the service's ongoing notification is suppressed. The service still
      runs, but the person carrying the phone loses the always-visible signal that it is collecting —
      which is the whole bargain a location foreground service is built on. Requested at runtime with
      the foreground-location step, and its absence is surfaced in the UI rather than ignored.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      REBOOT-1 - collection survives a reboot. Without this the boot broadcast is never delivered and
      a phone that restarts silently stops reporting, which is the failure this permission exists to
      close: the only signal today is the server marking the device stale.

      A BOOT_COMPLETED receiver is allowed to start a location foreground service. Android names the
      types it may NOT start - dataSync, camera, mediaPlayback, phoneCall, mediaProjection,
      microphone - and location is not among them. ACCESS_BACKGROUND_LOCATION above is the condition
      that does bind, and collect/BootRestartDecision checks it before anything is asked for.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tracker">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported="false": nothing outside this app may start location collection. An exported
          service that collects location would let any app on the device turn the family tracker on.
        -->
        <service
            android:name=".collect.LocationCollectionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          ALERT-2 - the first-party receive path. exported="false" for the same reason the collection
          service is: nothing outside this app may drive it. The intent filter is how FCM's own
          dispatcher finds it, and it is the only route into this service.

          NOTE the absence of a com.google.firebase.messaging.default_notification_* meta-data block.
          Those configure the fallback notification FCM posts ITSELF when the app is in the
          background, which would render a message this app never validated - exactly the "fabricate
          the missing part" behaviour the receive path refuses. Every crossing this app shows has
          been through TrackerMessagingService and AlertIntake, or it is not shown.
        -->
        <!--
          REBOOT-1 - the boot path. exported="true" is REQUIRED here and is the opposite of the rule
          the two services follow: ACTION_BOOT_COMPLETED is a protected system broadcast delivered
          from outside this app, so a receiver that is not exported is never reached and the restart
          silently never happens. What makes that safe is the receiver's own first line - it acts on
          ACTION_BOOT_COMPLETED and on nothing else - plus the fact that the broadcast is protected:
          only the system may send it, so no other app can forge one. A receiver that acted on
          whatever it was handed would be a way for anything on the device to ask this phone to start
          reporting where its owner is.

          directBootAware is left at its default (false) deliberately. The app's data lives in
          credential-encrypted storage, so the stored ask and the server settings are not readable
          until the phone is first unlocked; a direct-boot-aware receiver would run before it could
          read either and would have to guess. The broadcast is delivered after unlock instead, which
          is the correct moment rather than a compromise.
        -->
        <receiver
            android:name=".collect.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".alert.TrackerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
